// 디버그 실행 설정입니다. F5 를 누르면 실행 및 디버그 보기(Ctrl+Shift+D) 위쪽 드롭다운에서 고른 항목으로 시작합니다.
// type 이 cppvsdbg 인 이유: Windows(MSVC 도구 체인)에서 Rust 실행 파일(.exe와 .pdb)을 디버그하려면
// Microsoft C/C++ 확장(ms-vscode.cpptools)의 Visual Studio Windows 디버거를 쓰라는 것이 VS Code 공식 Rust 문서의 안내입니다.
// 디버거는 빌드를 하지 않으므로 preLaunchTask 로 먼저 cargo build 를 실행합니다.
// 속성 이름은 cpptools 확장(1.35.6)의 cppvsdbg 설정 스키마로 확인했습니다. 옛 속성 externalConsole 은 console 로 대체되어 쓰지 않습니다.
{
  "version": "0.2.0",
  "configurations": [
    {
      // 레슨 크레이트의 실행 파일을 디버그합니다. 시작하면 입력창이 뜨는데, 실행 파일 이름을 적습니다.
      // src/main.rs 의 실행 파일은 크레이트 이름(예: lesson04), src/bin/args.rs 의 실행 파일은 파일 이름(예: args)입니다.
      // 해당 레슨의 소스 파일을 열어 둔 상태에서 시작해야 같은 레슨이 빌드됩니다.
      "name": "Rust: 현재 레슨 디버그",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/lab/target/debug/${input:rustBinary}.exe",
      "args": [],
      "cwd": "${workspaceFolder}/lab",
      "stopAtEntry": false,
      // 프로그램 출력은 디버그 콘솔(Ctrl+Shift+Y)에 나옵니다. 이 값은 console 의 기본값(internalConsole)이라 따로 적지 않았습니다.
      // 키보드 입력이 필요한 프로그램은 "console": "integratedTerminal" 을 추가하면 통합 터미널에서 실행됩니다.
      "preLaunchTask": "cargo: build current lesson"
    },
    {
      // 레슨 11의 Task API 서버(axum)를 디버그합니다. 서버 코드에 중단점을 걸고 .http 파일로 요청을 보내 보세요.
      "name": "Rust: Task API 디버그",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/lab/target/debug/lesson11.exe",
      "args": [],
      "cwd": "${workspaceFolder}/lab",
      "stopAtEntry": false,
      // 서버 로그는 디버그 콘솔(Ctrl+Shift+Y)에 나옵니다(console 기본값 internalConsole).
      // 서버가 열 포트입니다(기본 3000).
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        }
      ],
      "preLaunchTask": "cargo: build task api"
    }
  ],
  "inputs": [
    {
      // 위 "Rust: 현재 레슨 디버그"가 시작할 때 묻는 값입니다.
      "id": "rustBinary",
      "type": "promptString",
      "description": "디버그할 실행 파일 이름 (예: lesson04, 또는 src/bin/args.rs 이면 args)",
      "default": "lesson02"
    }
  ]
}
