// 디버그 실행 설정입니다. F5 를 누르면 실행 및 디버그 보기(Ctrl+Shift+D) 위쪽 드롭다운에서 고른 항목으로 시작합니다.
// Go 디버거(dlv)는 Go 확장이 설치합니다. 처음 쓸 때 설치 안내가 나오면 "Go: Install/Update Tools"에서 dlv 를 선택하세요.
{
  "version": "0.2.0",
  "configurations": [
    {
      // 지금 열어 둔 파일이 속한 패키지를 디버그합니다.
      // mode 가 auto 이면 main 패키지는 프로그램으로 실행하고, _test.go 파일이면 테스트로 실행합니다.
      "name": "Go: 현재 파일 디버그",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      // 파일이 있는 폴더(패키지 전체)를 대상으로 합니다. 단일 파일만 빌드하면 같은 패키지의 다른 파일을 못 찾습니다.
      "program": "${fileDirname}"
    },
    {
      // 레슨 10의 Task API 서버를 디버그합니다. 서버 코드에 중단점을 걸고 curl 이나 .http 파일로 요청을 보내 보세요.
      "name": "Go: Task API 디버그",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/lab/lesson10/cmd/taskapi",
      // 서버가 열 포트입니다(기본 8080).
      "env": {
        "PORT": "8080"
      }
    }
  ]
}
